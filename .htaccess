<IfModule mod_rewrite.c>
  RewriteEngine On
  SetEnvIf Authorization "(.*)" HTTP_AUTHORIZATION=$1
  CGIPassAuth On

  # Pass the Authorization header to the public directory
  RewriteCond %{HTTP:Authorization} .
  RewriteRule .* - [E=HTTP_AUTHORIZATION:%{HTTP:Authorization}]

  # Agar URL me /public ho to redirect kare without /public
  RewriteCond %{REQUEST_URI} ^/public(.*)$ [NC]
  RewriteRule ^public(.*)$ /%1 [L,R=301]

  # Normal Laravel routing
  RewriteRule ^(.*)$ public/$1 [L]
</IfModule>

# php -- BEGIN cPanel-generated handler, do not edit
# Set the “alt-php82” package as the default “PHP” programming language.
<IfModule mime_module>
  AddHandler application/x-httpd-alt-php82 .php .php8 .phtml
</IfModule>
# php -- END cPanel-generated handler, do not edit
